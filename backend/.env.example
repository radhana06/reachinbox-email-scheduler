PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

DATABASE_URL=postgres://postgres:postgres@localhost:5432/scheduler
REDIS_URL=redis://localhost:6379
ELASTIC_URL=http://localhost:9200

# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack OAuth (api.slack.com/apps)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Scheduler tuning (nothing is hardcoded)
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=50
SENDER_COUNT=3
RUN_WORKER=true

# Optional (hosted Elasticsearch with API key instead of credentials in ELASTIC_URL)
# ELASTIC_API_KEY=
